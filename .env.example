# .env.example
# Retrieve an OpenAI API Key from platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here

# Retrieve a Pexels API Key from pexels.com/api
PEXELS_API_KEY=your_pexels_api_key_here

# For YouTube Data API, you will need 'client_secrets.json' in the root directory.
# (Obtained from Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs)

# Optional settings
YOUTUBE_CHANNEL_ID=your_channel_id
VIDEO_CATEGORY_ID=28  # 28=Science & Technology, default is 28
